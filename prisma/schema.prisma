// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model ClinicSession {

  //unique id created for each entry automatically

  id        String @id @default(cuid())
  date      String
  startTime String
  endTime   String

  programType String
  level       Int?

  capacity Int

  fullSessionCount Int @default(0)
  makeUpCount      Int @default(0)
  singleDateCount  Int @default(0)

  responseLink ResponseLink?
  attendances SessionAttendance[]

  // Timestamp when this record was first created
  createdAt DateTime @default(now())

  // Timestamp automatically updated whenever this record changes
  updatedAt DateTime @updatedAt

  // Uses the date field as an index to quickly find sessions.
  // I picture it like:
  //
  // July 4  ---> Session 1, Session 2
  // July 5  ---> Session 3
  // July 6  ---> Session 4, Session 5
  //
  // This lets the database quickly find all sessions for a
  // specific date instead of searching every row.
  @@index([date])

  // Uses programType and level together as an index.
  //
  // Junior, Level 1 ---> Session 2, Session 8
  // Junior, Level 2 ---> Session 3
  // Adult,  N/A     ---> Session 5
  //
  // This lets the database quickly find sessions that match
  // both the program type and level.
  @@index([programType, level])
}

model ResponseLink {
  id    String @id @default(cuid())
  token String @unique

  sessionId String @unique
  session   ClinicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  expiresAt DateTime?
  closedAt  DateTime?

  createdAt DateTime @default(now())

  responses SessionResponse[]
}

model SessionResponse {
  id String @id @default(cuid())

  familyCode String

  linkId String
  link   ResponseLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  choice String
  kidNames Json?

  createdAt DateTime @default(now())

  // ✅ FINAL TOUCH:
  // One row per family per link — database enforced.
  @@unique([linkId, familyCode])

  // Helpful indexes
  @@index([linkId])
  @@index([createdAt])
}

model SessionAttendance {
  id String @id @default(cuid())

  sessionId String
  session   ClinicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // display name
  kidName String

  // unique internal key to distinguish duplicates like "Raj"
  kidKey String

  // optional, helpful for debugging
  familyCode String?

  attended Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, kidKey])
  @@index([sessionId])
}





