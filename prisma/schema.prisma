// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ClinicSession {
  id        String @id @default(cuid())
  date      String // "YYYY-MM-DD"
  startTime String // "HH:MM" 24-hour
  endTime   String // "HH:MM" 24-hour

  // Keep as String so your existing seed/API keeps working
  // Expected values you already use: "JUNIORS" | "RED_BALL"
  programType String
  level       Int? // 1-4 for juniors, null for red ball

  capacity Int

  // Phase 0 attendance breakdown
  fullSessionCount Int @default(0)
  makeUpCount      Int @default(0)
  singleDateCount  Int @default(0)

  // Phase 1: one reusable response link per session
  responseLink ResponseLink?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Helpful for listing/grouping
  @@index([date])
  @@index([programType, level])
}

model ResponseLink {
  id        String @id @default(cuid())
  token     String @unique

  // one-to-one with ClinicSession (Step 4 "create or reuse")
  sessionId String @unique
  session   ClinicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Optional guardrail — you can keep it even if you compute “closed” in API
  expiresAt DateTime?

  // ✅ Step 6: manual close / reopen support
  // null   = open
  // set    = manually closed
  closedAt DateTime?

  createdAt DateTime @default(now())

  responses SessionResponse[]
}

model SessionResponse {
  id     String @id @default(cuid())

  linkId String
  link   ResponseLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  // Keep as String so your existing POST body stays the same
  // Expected: "attending" | "not_attending"
  choice String

  createdAt DateTime @default(now())

  @@index([linkId])
  @@index([createdAt])
}





